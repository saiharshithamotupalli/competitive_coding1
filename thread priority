//concept of THREAD PRIORITYY
class PriorityThread extends Thread
 {
  public void run()
  {
   System.out.println("priority thread method"); 
  }
}
class ThreadPriority
 {
   public static void main(String args[])
    {
      PriorityThread t1=new PriorityThread();
      PriorityThread t2=new PriorityThread ();
      t1.start();
      System.out.println("thread priority of t1 :"+t1.getPriority());
      System.out.println("thread priority of t2 :"+t2.getPriority());
      t1.setPriority(4);
	System.out.println("thread priority of t1 :"+t1.getPriority());
      System.out.println("thread priority of t2 :"+t2.getPriority());
      // System.out.println("cuurent priority of t1 :"+ThreadCurrent.getName());

    }



}
