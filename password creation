import re
password_pattern=re.compile(  r'^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%&*])[a-zA-z\d!@#$%&*]{}8,$')
print(type(password_pattern))
password=["hello123","hai1234","strong#12345"]
for pw in password:
   if password_pattern.match(pw):
      print("valid password :",pw)
   else:
      print("invalid password :",pw)
